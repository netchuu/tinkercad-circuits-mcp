{
  "name": "tinkercad-circuits-mcp",
  "version": "0.1.0",
  "mcpName": "io.github.netchuu/tinkercad-circuits-mcp",
  "description": "MCP server that builds and simulates Arduino breadboard circuits in Autodesk Tinkercad Circuits. Works with Claude Code, Claude Desktop, Cursor, Codex and other MCP clients.",
  "keywords": [
    "tinkercad",
    "tinkercad-circuits",
    "arduino",
    "arduino-uno",
    "breadboard",
    "circuit-simulator",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "playwright",
    "electronics",
    "education",
    "cursor",
    "codex"
  ],
  "license": "MIT",
  "author": "Azamat Medenov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netchuu/tinkercad-circuits-mcp.git"
  },
  "homepage": "https://github.com/netchuu/tinkercad-circuits-mcp#readme",
  "bugs": "https://github.com/netchuu/tinkercad-circuits-mcp/issues",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tinkercad-circuits-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "login": "node dist/login.js",
    "test": "tsx --test test/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "parts-doc": "tsx scripts/parts-doc.ts > docs/parts.md",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright-core": "^1.55.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
